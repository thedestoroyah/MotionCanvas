<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <vn.edu.tdtu.motioncanvas.drawing.DrawingView
        android:id="@+id/drawing_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Hàng 1: combobox loại bút + xem trước nét (chạm để chọn độ dày) + nút bảng màu; hàng 2: các ô màu có sẵn chiếm trọn chiều ngang -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <Spinner
                android:id="@+id/brush_spinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/brush_label"
                android:entries="@array/brushes"
                android:minHeight="48dp" />

            <vn.edu.tdtu.motioncanvas.drawing.BrushPreviewView
                android:id="@+id/brush_preview"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginHorizontal="8dp"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="@string/brush_preview"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_palette"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/palette" />
        </LinearLayout>

        <!-- Các ô màu dàn đều hết chiều ngang (mỗi ô một phần weight) -->
        <LinearLayout
            android:id="@+id/swatch_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp" />

        <LinearLayout
            android:id="@+id/tool_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <Button
                android:id="@+id/btn_symmetry"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btn_replay"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="@string/replay" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_undo"
                style="@style/Widget.MotionCanvas.ActionButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/undo"
                app:icon="@drawable/ic_undo" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_redo"
                style="@style/Widget.MotionCanvas.ActionButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/redo"
                app:icon="@drawable/ic_redo" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_clear"
                style="@style/Widget.MotionCanvas.ActionButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/clear"
                app:icon="@drawable/ic_delete" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save"
                style="@style/Widget.MotionCanvas.ActionButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/save"
                app:icon="@drawable/ic_save" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
